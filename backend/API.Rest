@baseUrl = http://localhost:3000
@escuelaId = REEMPLAZA_ID_ESCUELA
@usuarioEmail = milton.ortiz@correo.com
@usuarioPassword = 123456

# AUTH

### Login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
    "email": "{{usuarioEmail}}",
    "password": "{{usuarioPassword}}"
}

# ESCUELAS

### Obtener escuelas
GET {{baseUrl}}/api/escuelas

### Crear escuela
POST {{baseUrl}}/api/escuelas
Content-Type: application/json

{
    "nombre": "Escuela Arnol David Sanchez",
    "codigo": "ESC-002",
    "departamento": "Cortes",
    "municipio": "Santa Cruz de Yojoa",
    "direccion": "Pena Blanca",
    "activa": true
}

### Actualizar escuela (reemplaza el id)
PUT {{baseUrl}}/api/escuelas/REEMPLAZA_ID_ESCUELA
Content-Type: application/json

{
    "nombre": "Escuela Arnol David Sanchez Actualizada",
    "codigo": "ESC-002",
    "departamento": "Cortes",
    "municipio": "Santa Cruz de Yojoa",
    "direccion": "Pena Blanca",
    "activa": true
}

### Desactivar/eliminar escuela (reemplaza el id)
DELETE {{baseUrl}}/api/escuelas/REEMPLAZA_ID_ESCUELA



# USUARIOS

### Obtener usuarios
GET {{baseUrl}}/api/usuarios

### Crear usuario
POST {{baseUrl}}/api/usuarios
Content-Type: application/json

{
    "nombre": "Milton Ortiz",
    "email": "milton.ortiz@correo.com",
    "password": "123456",
    "rol": "alumno",
    "escuela": "6a1fe41b657bc97d75b4a48f",
    "puntos": 0,
